{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ophelia LLM Telegram Intent Schema",
  "type": "object",
  "properties": {
    "intent_type": {
      "enum": ["MARKET_QUERY", "AUTOMATION_CREATE", "CONDITION_CREATE",
               "AUTOMATION_CONTROL", "HEALTH_QUERY", "NEWS_QUERY", "CHAT"]
    },
    "strategy": {"enum": ["EMA_CROSSOVER", "VWAP_SUPERTREND", null]},
    "symbol": {"type": ["string", "null"], "pattern": "^[A-Z]{2,10}-USDT$"},
    "timeframe_min": {"enum": [1, 2, 3, 5, 10, 15, 30, 60, null]},
    "lookback_min": {"type": ["integer", "null"], "minimum": 1, "maximum": 1440},
    "aggregation_interval_min": {"enum": [1, 2, 3, 5, 10, 15, 30, 60, null]},
    "direction_preference": {"enum": ["BULLISH", "BEARISH", "ANY", null]},
    "margin_usage_pct": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 100},
    "leverage": {"type": ["number", "null"], "minimum": 1, "maximum": 50},
    "action": {"enum": ["PAUSE", "RESUME", "CANCEL", "SKIP", "LIST", null]},
    "automation_id": {"type": ["integer", "null"]},
    "analytics_requested": {
      "type": "array",
      "items": {"enum": ["candles", "movement", "volume_flow", "volume_profile",
                          "order_book", "ema", "vwap", "supertrend",
                          "crossover_estimate"]}
    },
    "missing_parameters": {"type": "array", "items": {"type": "string"}},
    "reply_hint": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "timestamp": {"type": "string"}
  },
  "required": ["intent_type"],
  "additionalProperties": false,
  "note": "Execution intents (execute/cancel/modify exchange orders) are NOT part of this schema and are rejected by the validator deny-list. Raw LLM text never reaches Ophelia Core."
}
